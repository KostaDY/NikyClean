
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from openpyxl import load_workbook
from pathlib import Path
import csv
import subprocess
import time

# ============================================================
# SETTINGS
# ============================================================

EXCEL_FILE = Path("/Users/kostayanev/NikyClean/Entry_CorrectHistory.xlsm")
SHEET_NAME = "Hist"
OUT_CSV = Path("/Users/kostayanev/NikyClean/Chrono_History.csv")

START_ROW = 103
END_ROW = 196
START_COL = 1       # column A
END_COL = 2105      # column CBA

# ============================================================
# CLOSE EXCEL (macOS)
# ============================================================

def close_excel():
    try:
        subprocess.run(
            ["osascript", "-e", 'tell application "Microsoft Excel" to quit'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        time.sleep(2)
    except Exception:
        pass


# ============================================================
# OPEN EXCEL
# ============================================================

def open_excel(path):
    try:
        subprocess.run(["open", str(path)])
    except Exception:
        pass


# ============================================================
# MAIN
# ============================================================

def main():

    print("Closing Excel if running...")
    close_excel()

    print("Opening workbook...")
    wb = load_workbook(EXCEL_FILE, data_only=True, read_only=True)
    ws = wb[SHEET_NAME]

    print("Writing CSV...")

    with open(OUT_CSV, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)

        for row in ws.iter_rows(
                min_row=START_ROW,
                max_row=END_ROW,
                min_col=START_COL,
                max_col=END_COL,
                values_only=True):

            writer.writerow(row)

    wb.close()

    print("CSV created:", OUT_CSV)

    print("Reopening Excel workbook...")
    open_excel(EXCEL_FILE)


# ============================================================

if __name__ == "__main__":
    main()